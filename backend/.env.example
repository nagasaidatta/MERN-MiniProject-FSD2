# Backend Server Port (Default 5001 avoids macOS AirPlay port 5000 conflict)
PORT=5001

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication Secret Key (Use a strong random string in production)
JWT_SECRET=gov_scheme_portal_super_secret_jwt_key_2026_production_quality

# JWT Expiration Period
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL (For CORS in production)
CLIENT_URL=http://localhost:5173
